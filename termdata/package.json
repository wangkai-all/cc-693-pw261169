{
  "name": "termdata",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "终端字节流数据接入工具：还原屏幕状态并抽取设备状态表",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build:core": "tsc -p tsconfig.json",
    "build:web": "vite build",
    "build": "npm run build:core && npm run build:web",
    "dev:server": "tsx watch src/server/server.ts",
    "dev:web": "vite",
    "demo": "tsx src/demo/demo.ts",
    "gen:samples": "tsx scripts/gen-samples.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "start": "node dist/server/server.js"
  },
  "dependencies": {
    "@fastify/static": "^8.0.0",
    "@fastify/websocket": "^11.0.0",
    "@xterm/headless": "^6.0.0",
    "@xterm/xterm": "^6.0.0",
    "fastify": "^5.0.0",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "@xterm/addon-fit": "^0.11.0",
    "tsx": "^4.19.0",
    "typescript": "^5.9.0",
    "vite": "^8.0.0",
    "vitest": "^5.0.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
